# Copy this file to .env and fill it in. Never commit .env.

# --- PayPal sandbox ---
# developer.paypal.com -> Apps & Credentials (Sandbox) -> your REST app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# A sandbox *personal* account email (Testing Tools -> Sandbox Accounts)
PAYPAL_TEST_RECEIVER=

# --- YouTube Data API v3 ---
# console.cloud.google.com -> enable "YouTube Data API v3" -> Credentials -> API key
YOUTUBE_API_KEY=

# --- Gemini ---
# aistudio.google.com -> Get API key
GEMINI_API_KEY=
# Optional: override the model
GEMINI_MODEL=gemini-3.8-flash

# --- Test videos (your own public uploads) ---
# One video WITH a proper spoken + on-screen sponsor disclosure, one WITHOUT.
TEST_VIDEO_COMPLIANT=
TEST_VIDEO_NONCOMPLIANT=
