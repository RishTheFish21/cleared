{
  "name": "cleared",
  "version": "0.1.0",
  "private": true,
  "description": "Creators get paid the minute their sponsored post passes compliance. PayPal Payouts + AI video verification.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node --env-file-if-exists=.env server/index.js",
    "spike:paypal": "node --env-file-if-exists=.env spikes/paypal-payout.mjs",
    "spike:youtube": "node --env-file-if-exists=.env spikes/youtube-flag.mjs",
    "spike:gemini": "node --env-file-if-exists=.env spikes/gemini-disclosure.mjs",
    "spikes": "node --env-file-if-exists=.env spikes/run-all.mjs",
    "build": "vite build",
    "seed": "node --env-file-if-exists=.env scripts/seed.mjs"
  },
  "dependencies": {
    "@bryntum/scheduler": "npm:@bryntum/scheduler-trial@^7.3.8",
    "@bryntum/scheduler-react": "^7.3.8",
    "@paypal/agent-toolkit": "^1.11.0",
    "ai": "^4.3.19",
    "express": "^4.22.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.4.5"
  },
  "allowScripts": {
    "@bryntum/scheduler-trial@7.3.8": true,
    "@bryntum/scheduler-trial-lib@1.0.1": true
  }
}
